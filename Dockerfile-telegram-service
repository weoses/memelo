FROM golang:1.24.10-alpine AS builder

WORKDIR /app
RUN apk add --update --no-cache bash curl \
    gcc g++ vips vips-dev vips-poppler pkgconf \
    poppler-dev musl-dev libc6-compat 

COPY ./gen gen/
COPY ./common common/
COPY ./tests/e2e tests/e2e
COPY ./storage-service ./storage-service
COPY ./telegram-service ./telegram-service
COPY ./go.work ./go.work
COPY ./go.work.sum ./go.work.sum

RUN go build -a -installsuffix cgo -o telegram-service.bin ./telegram-service

FROM alpine:latest 

WORKDIR /app
COPY --from=builder /app/telegram-service.bin telegram-service

WORKDIR /app/config
ENV APPLICATION_CONFIGPATH "/app/config"

WORKDIR /app
ENTRYPOINT [ "/app/telegram-service" ]