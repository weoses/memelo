# Override config.yaml values via environment variables.
# Viper maps keys: dots and dashes → underscores
# e.g. storage-service.Uri → STORAGE_SERVICE_URI

# SERVER_LISTENADDRESS=:7003
# STORAGE_SERVICE_URI=http://localhost:7001
# ACCOUNT_ID=your-uuid-here
# LOG_LEVEL=info

# S3 / temp storage (MinIO or compatible)
# TEMP_STORAGE_ENDPOINT=localhost:9000
# TEMP_STORAGE_ACCESSKEY=minioadmin
# TEMP_STORAGE_SECRETKEY=minioadmin
# TEMP_STORAGE_BUCKET=memelo-temp
# TEMP_STORAGE_SECURE=false

# JWT
# JWT_SECRET=change-me-in-production
